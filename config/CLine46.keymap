#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/unicode.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        unicode_left: unicode_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc 0x2190 0>;
            label = "UNICODE_LEFT";
        };

        unicode_up: unicode_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc 0x2191 0>;
            label = "UNICODE_UP";
        };

        unicode_right: unicode_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc 0x2192 0>;
            label = "UNICODE_RIGHT";
        };

        unicode_down: unicode_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc 0x2193 0>;
            label = "UNICODE_DOWN";
        };

        profile_windows: profile_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc UC_SET_WIN_COMPOSE &bt BT_SEL 0>;
            label = "PROFILE_WINDOWS";
        };

        profile_macos: profile_macos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc UC_SET_MACOS &bt BT_SEL 2>;
            label = "PROFILE_MACOS";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LCTRL TAB     &kp Q &kp W &kp E &kp R &kp T    &kp Y &kp U &kp I    &kp O    &mt MINUS P &kp BSPC
&mt LS(N2) LS(N7) &kp A &kp S &kp D &kp F &kp G    &kp H &kp J &kp K    &kp L    &kp UP      &lt 3 RET
&mt LSHFT LSHFT   &kp Z &kp X &kp C &kp V &kp B    &kp N &kp M &kp FSLH &kp LEFT &kp DOWN    &kp RIGHT
  &mt LCTRL LCTRL  &kp LGUI  &kp LALT  &lt 2 C_MUTE  &lt 1 LANG2  &lt 4 SPACE    &lt 5 SPACE  &mt LSHFT LANG1  &kp COMMA  &kp DOT
            >;
        };

        
        layer_1 {
            bindings = <
&kp ESC   &kp N7 &kp N8 &kp N9 &kp LS(SEMI)  &kp MINUS     &kp LBKT   &kp LS(N3) &kp LS(N8)    &kp LS(N9)  &kp LS(N1)   &trans
&kp DOT   &kp N4 &kp N5 &kp N6 &kp LS(SQT)   &kp FSLH      &kp LS(N4) &kp LS(N6) &kp RBKT      &kp NUHS    &kp LS(FSLH) &trans
&kp LSHFT &kp N1 &kp N2 &kp N3 &kp LS(MINUS) &kp LS(N5)    &kp SEMI   &kp SQT    &kp LS(COMMA) &kp LS(DOT) &trans       &kp LS(INT1)
  &kp N0  &kp N0  &kp LALT  &trans  &trans  &trans         &trans  &trans  &trans  &trans
            >;
        };


        MOUSE {
            bindings = <
&trans &kp F7 &kp F8 &kp F9 &kp F10 &trans    &profile_windows &trans &trans &trans  &trans  &kp DEL
&trans &kp F4 &kp F5 &kp F6 &kp F11 &trans    &bt BT_SEL 1     &trans &trans &trans  &kp F13 &trans
&trans &kp F1 &kp F2 &kp F3 &kp F12 &trans    &profile_macos   &trans &trans &kp F14 &kp F15 &kp F16
  &trans  &trans  &trans  &trans  &trans  &trans    &studio_unlock  &trans  &kp HOME  &kp END
            >;
        };


        SCROLL {
            bindings = <
&trans &none &none &none &mkp MB1 &mkp MB2    &none &mkp MB1 &mkp MB1 &mkp MB2 &mkp MB2 &trans
&trans &none &none &none &none    &none       &none &none    &none    &none    &kp UP   &trans
&trans &none &none &none &none    &none       &none &none    &none    &kp LEFT &kp DOWN &kp RIGHT
  &trans  &trans  &trans  &trans  &to 0  &trans    &trans  &to 0  &mkp MB1  &mkp MB2
            >;
        };


        layer_4 {
            bindings = <
&trans &trans &trans &trans &mkp MB1 &mkp MB2    &trans &mkp MB1 &mkp MB1 &mkp MB2 &mkp MB2 &trans
&trans &trans &trans &trans &trans   &trans      &trans &trans   &trans   &trans   &kp UP   &trans
&trans &trans &trans &trans &trans   &trans      &trans &trans   &trans   &kp LEFT &kp DOWN &kp RIGHT
  &trans  &trans  &trans  &trans  &to_layer_0 LANG2  &trans    &trans  &to_layer_0 LANG1  &mkp MB1  &mkp MB2
            >;
        };


        layer_5 {
            bindings = <
&trans &none &none &none &none &none    &kp LC(Y) &kp LC(Z) &kp LC(C) &kp LC(V)    &kp LC(LS(V)) &trans
&none  &none &none &none &none &none    &none     &kp LC(A) &none     &none        &kp LC(UP)    &trans
&trans &none &none &none &none &none    &none     &none     &none     &kp LC(LEFT) &kp LC(DOWN)  &kp LC(RIGHT)
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &none  &none
            >;
        };


        layer_6 {
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
