#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/unicode.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー番号（overlay の scroller と conditional_layers で使う）
#define FN_LAYER     2
#define SCROLL_LAYER 3
#define WIN_MODE     6
#define WIN_SCROLL   7
#define WIN_ARROWS   8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        unicode_left: unicode_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc 0x2190 0>;
            label = "UNICODE_LEFT";
        };

        unicode_up: unicode_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc 0x2191 0>;
            label = "UNICODE_UP";
        };

        unicode_right: unicode_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc 0x2192 0>;
            label = "UNICODE_RIGHT";
        };

        unicode_down: unicode_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc 0x2193 0>;
            label = "UNICODE_DOWN";
        };

        profile_windows: profile_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // BT 0（Windows）へ切り替え、Windows モード（レイヤー6）をオンにする。
            // そのあと BT 1（Duo）との接続を切る（つないだままだと Duo のソフトウェアキーボードが出ないため）。
            // 先に切り替えてから切断する（逆だと、切断直後に BT 1 がまだ選ばれていて Duo が再接続してしまう）
            bindings = <&uc UC_SET_WIN_COMPOSE &tog_on WIN_MODE &bt BT_SEL 0 &bt BT_DISC 1>;
            label = "PROFILE_WINDOWS";
        };

        profile_macos: profile_macos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // BT 2（Mac）へ切り替え、Windows モードをオフにする。そのあと BT 1（Duo）との接続を切る（理由は profile_windows と同じ）
            bindings = <&uc UC_SET_MACOS &tog_off WIN_MODE &bt BT_SEL 2 &bt BT_DISC 1>;
            label = "PROFILE_MACOS";
        };

        profile_duo: profile_duo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // BT 1（Duo / Android）へ切り替え、Windows モードをオフにする（Mac と同じ動き）
            bindings = <&tog_off WIN_MODE &bt BT_SEL 1>;
            label = "PROFILE_DUO";
        };

        // Windows の Alt＋テンキー入力で矢印記号を出す（Alt を押したままテンキー 24〜27。NumLock オン・直接入力モードが前提）
        win_arrow_up: win_arrow_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N2 &kp KP_N4>, <&macro_release &kp LALT>;
            label = "WIN_ARROW_UP";
        };

        win_arrow_down: win_arrow_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N2 &kp KP_N5>, <&macro_release &kp LALT>;
            label = "WIN_ARROW_DOWN";
        };

        win_arrow_right: win_arrow_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N2 &kp KP_N6>, <&macro_release &kp LALT>;
            label = "WIN_ARROW_RIGHT";
        };

        win_arrow_left: win_arrow_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N2 &kp KP_N7>, <&macro_release &kp LALT>;
            label = "WIN_ARROW_LEFT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // レイヤーを必ずオン / 必ずオフにする（押すたびに反転する &tog と違い、何度押しても同じ結果）
        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        // ジェスチャ（左親指4＋ボールを左右）で使う。Ctrl（Z の下。Mac では Command）を押していたら別のキーに変える。
        // 押していた Ctrl はホストに送らない（mod-morph の標準動作）。
        // Mac: F17/F18＝ウィンドウを左/右半分、F19/F20＝左/右のモニターへ（どちらも Hammerspoon が処理）
        gest_mac_left: gest_mac_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp F17>, <&kp F19>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        gest_mac_right: gest_mac_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp F18>, <&kp F20>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        // Windows: Win+←/→＝ウィンドウを左/右半分、Win+Shift+←/→＝左/右のモニターへ（Windows 標準）
        gest_win_left: gest_win_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT)>, <&kp LG(LS(LEFT))>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        gest_win_right: gest_win_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT)>, <&kp LG(LS(RIGHT))>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    // Windows モード中だけ有効になるレイヤー
    //   スクロールキー（レイヤー3）を押している ＋ Windows モード → レイヤー7（スクロール上下左右反転。overlay 側で設定）
    //   レイヤー2 を押している ＋ Windows モード → レイヤー8（矢印位置を Alt＋テンキー入力に置き換え）
    conditional_layers {
        compatible = "zmk,conditional-layers";
        win_scroll {
            if-layers = <SCROLL_LAYER WIN_MODE>;
            then-layer = <WIN_SCROLL>;
        };
        win_arrows {
            if-layers = <FN_LAYER WIN_MODE>;
            then-layer = <WIN_ARROWS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LCTRL TAB     &kp Q &kp W &kp E &kp R &kp T    &kp Y &kp U &kp I    &kp O    &mt MINUS P &kp BSPC
&mt LS(N2) LS(N7) &kp A &kp S &kp D &kp F &kp G    &kp H &kp J &kp K    &kp L    &kp UP      &lt 3 RET
&mt LSHFT LSHFT   &kp Z &kp X &kp C &kp V &kp B    &kp N &kp M &kp FSLH &kp LEFT &kp DOWN    &kp RIGHT
  &mt LCTRL LCTRL  &kp LGUI  &kp LALT  &lt 2 C_MUTE  &lt 1 LANG2  &lt 4 SPACE    &lt 5 SPACE  &mt LSHFT LANG1  &kp COMMA  &kp DOT
            >;
        };

        
        layer_1 {
            bindings = <
&kp ESC &kp N7 &kp N8 &kp N9 &kp LS(SEMI) &kp MINUS    &kp LBKT &kp LS(N3) &kp LS(N8) &kp LS(N9) &kp LS(N1) &trans
&kp DOT &kp N4 &kp N5 &kp N6 &kp LS(SQT) &kp FSLH    &kp LS(N4) &kp LS(N6) &kp RBKT &kp NUHS &kp LS(FSLH) &trans
&kp LSHFT &kp N1 &kp N2 &kp N3 &kp EQUAL &kp LS(N5)    &kp SEMI &kp SQT &kp LS(COMMA) &kp LS(DOT) &trans &kp LS(INT1)
  &kp N0  &kp LS(MINUS)  &kp LALT  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };


        MOUSE {
            bindings = <
&trans &kp F7 &kp F8 &kp F9 &kp F10 &trans    &profile_windows &trans &trans &trans  &trans  &kp DEL
&trans &kp F4 &kp F5 &kp F6 &kp F11 &trans    &profile_duo     &trans &trans &trans  &kp F13 &trans
&trans &kp F1 &kp F2 &kp F3 &kp F12 &trans    &profile_macos   &trans &trans &kp F14 &kp F15 &kp F16
  &trans  &trans  &trans  &trans  &trans  &trans    &studio_unlock  &trans  &kp HOME  &kp END
            >;
        };


        SCROLL {
            bindings = <
&trans &none &none &none &mkp MB1 &mkp MB2    &none &mkp MB1 &mkp MB1 &mkp MB2 &mkp MB2 &trans
&trans &none &none &none &none    &none       &none &none    &none    &none    &kp UP   &trans
&trans &none &none &none &none    &none       &none &none    &none    &kp LEFT &kp DOWN &kp RIGHT
  &trans  &trans  &trans  &trans  &to 0  &trans    &trans  &to 0  &mkp MB1  &mkp MB2
            >;
        };


        // レイヤー4: オートマウス（AML）。Y=貼り付け U=戻る H=コピー J=進む Shift=Shift、I/O 等=クリック
        layer_4 {
            bindings = <
&trans &trans &trans &trans &mkp MB1 &mkp MB2    &kp LC(V) &mkp MB4 &mkp MB1 &mkp MB2 &trans &trans
&trans &trans &trans &trans &trans &trans    &kp LC(C) &mkp MB5 &trans &trans &kp UP &trans
&kp LSHFT &trans &trans &trans &trans &trans    &trans &trans &trans &kp LEFT &kp DOWN &kp RIGHT
  &trans  &trans  &trans  &trans  &to_layer_0 LANG2  &trans    &trans  &to_layer_0 LANG1  &mkp MB1  &mkp MB2
            >;
        };


        layer_5 {
            bindings = <
&trans &none &none &none &none &none    &kp LC(Y) &kp LC(Z) &kp LC(C) &kp LC(V)    &kp LC(LS(V)) &trans
&none  &none &none &none &none &none    &none     &kp LC(A) &none     &none        &kp LC(UP)    &trans
&trans &none &none &none &none &none    &none     &none     &none     &kp LC(LEFT) &kp LC(DOWN)  &kp LC(RIGHT)
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &none  &none
            >;
        };


        // Windows モードの目印。中身はすべて &trans（打鍵には影響しない）。
        // BT 0 の切り替えキー（profile_windows）でオン、BT 1・2（profile_duo / profile_macos）でオフ。
        layer_6 {
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        // レイヤー7: Windows モードでスクロールキーを押している間（スクロールの向きは overlay の scroller_windows）
        WIN_SCROLL {
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        // レイヤー8: Windows モードで左親指4（レイヤー2）を押している間。矢印の位置だけ Alt＋テンキー入力
        WIN_ARROWS {
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &win_arrow_up &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &win_arrow_left &win_arrow_down &win_arrow_right
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
