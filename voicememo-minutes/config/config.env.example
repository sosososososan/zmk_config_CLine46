# ============================================================
# ボイスメモ議事録パイプライン 設定ファイル
#
# このファイルをコピーして編集してください:
#   cp config/config.env.example config/config.env
#
# config.env は .gitignore 済みなので、トークンやパスワードを
# 書いてもリポジトリにはコミットされません。
# ============================================================

# --- フォルダ設定 --------------------------------------------
# iPhone からの音声の受け取り場所(iCloud Drive 内)
INBOX_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/VoiceMemoInbox"

# 議事録・発言録の出力先(iCloud Drive 内 → iPhone の「ファイル」から見える)
OUTPUT_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/MeetingMinutes"

# 処理済み音声の退避先
ARCHIVE_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/MeetingMinutes/_archive"

# --- 文字起こし(オンデバイス)-------------------------------
# Whisper モデル。精度: large-v3 > large-v3-turbo > medium > small
# メモリ 8GB の MacBook Air では medium 以下を推奨
WHISPER_MODEL="large-v3-turbo"
LANGUAGE="ja"
BATCH_SIZE="4"

# --- 話者分離(pyannote、オンデバイス)-----------------------
# Hugging Face のアクセストークン(Read 権限)。
# 未設定の場合は話者分離をスキップし、全発言が「話者1」になります。
# 事前に以下 2 つのモデルページで「Agree and access repository」を
# 押しておくこと(同じアカウントで):
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=""
DIARIZATION="auto"        # auto = トークンがあれば実施 / off = 常にスキップ
MIN_SPEAKERS=""           # 人数が分かっている場合のみ(例: 2)。精度が上がる
MAX_SPEAKERS=""           # 例: 6

# --- Claude(議事録生成 / Max サブスクリプション)-------------
# Claude Code CLI のパス。install.sh が自動検出して絶対パスを書き込みます
CLAUDE_BIN="claude"
# 空 = アカウントのデフォルトモデル。Max の残量節約なら "sonnet" 推奨
CLAUDE_MODEL=""

# --- docx 変換 -----------------------------------------------
# "1" にすると pandoc(要 brew install pandoc)で変換。
# "0" は内蔵コンバータ(python-docx / 游ゴシック)。通常は 0 のままで OK
USE_PANDOC="0"

# --- メール送信(会社 PC へ)---------------------------------
# EMAIL_MODE:
#   never  = 送信しない(デフォルト)
#   always = 毎回送信
#   flag   = 音声ファイル名に EMAIL_FLAG の文字列を含む場合のみ送信
EMAIL_MODE="never"
EMAIL_FLAG="送信"

# Gmail の場合: SMTP_HOST=smtp.gmail.com / SMTP_PORT=587
# SMTP_PASS には Google の「アプリパスワード」(2段階認証プロセスが必要)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""             # 空なら SMTP_USER を使用
EMAIL_TO=""               # 会社のメールアドレス(カンマ区切りで複数可)
